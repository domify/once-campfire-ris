# `SearchesController` (reference/app/controllers/searches_controller.rb).
# `set_messages` runs before every action, so a query FTS5 rejects fails
# `create` and `clear` too.
module controllers/searches

import std/text
import models/message::{Message}
import models/search::{Search}
import models/room::{Room}
import rils/template/recorded::{Fragment}
import rils/routes/paths::{searches_path}
import rils/kit/ctx::{Ctx, ActionResult}
import rils/kit/errors::{HttpError}
import rils/kit/response::{Response}
import rils/kit/format::{HTML}
import rils/ruby/uri::{cgi_escape}
import views/searches::{Index}
import config/app::{App}
import integrations/search/word_ranges::{word?}
import controllers/concerns::{before_actions}
import controllers/messages::{MessagePresenter, current_user}
import controllers/welcome::{last_room_visited}

pub def index_searches(app : App, c : Ctx) : ActionResult
  passed = before_actions(app, c)
  return passed if passed.is_a?(HttpError)
  q = query_param(c)
  return q if q.is_a?(HttpError)
  current = passed.signed_in
  user = current.user
  query = searchable_query(q)
  messages = query ? app.db.read { |conn| Message.search_reachable(conn, user.id, query) } : [] of Message
  recent = app.db.read { |conn| Search.ordered_for_user(conn, user.id).map(&.query) }
  return_to = last_room_visited(app, c, current)
  format = c.respond_to([HTML])
  return format if format.is_a?(HttpError)
  ctx = app.layout_context(c, current_user(user), passed.platform)
  # Each result is its room's message partial, in the search's order.
  presenters = {} of Int64 => MessagePresenter
  fragments = messages.compact_map do |message|
    presenter = presenters[message.room_id]?
    unless presenter
      room = app.db.read { |conn| Room.find_by_id(conn, message.room_id) }
      presenter = room ? (presenters[message.room_id] = MessagePresenter.new(app, ctx, room, c.request.host)) : nil
    end
    presenter ? presenter.fragments([message]).first : nil
  end
  view = Index.new(ctx, query, q, fragments, recent, return_to ? return_to.id : 0_i64)
  app.render_layout(c, 200, "Search", "sidebar searches", ctx) { |buffer| view.render_into(buffer) }
end

# `create`: `Current.user.searches.record(query)`, then the results.
pub def create_search(app : App, c : Ctx) : ActionResult
  passed = before_actions(app, c)
  return passed if passed.is_a?(HttpError)
  q = query_param(c)
  return q if q.is_a?(HttpError)
  query = sanitize_query(q)
  # A nil query violates `query`'s NOT NULL.
  return HttpError.internal("NOT NULL constraint failed: searches.query") unless query
  app.db.write { |tx| Search.record(tx, passed.user.id, query) }
  c.redirect_to(c.url_for("#{searches_path}?q=#{cgi_escape(query)}"))
end

# `clear`: `Current.user.searches.destroy_all`.
pub def clear_searches(app : App, c : Ctx) : ActionResult
  passed = before_actions(app, c)
  return passed if passed.is_a?(HttpError)
  q = query_param(c)
  return q if q.is_a?(HttpError)
  app.db.write { |tx| Search.destroy_all_for_user(tx, passed.user.id) }
  c.redirect_to(c.url_for(searches_path))
end

# `params[:q]`; anything but a string makes `gsub` raise.
def query_param(c : Ctx) : String? | HttpError
  param = c.param("q") || return nil
  return nil if param.null?
  param.as_s? || HttpError.internal("undefined method 'gsub'")
end

# `params[:q]&.gsub(/[^[:word:]]/, " ")`: one space per character.
pub def sanitize_query(q : String?) : String?
  return nil unless q
  String.build { |io| q.each_char { |char| io << (word?(char) ? char : ' ') } }
end

# The query `set_messages` searches for: none when it's blank.
def searchable_query(q : String?) : String?
  query = sanitize_query(q)
  query && !query.blank? ? query : nil
end
