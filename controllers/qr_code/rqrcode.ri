# A port of rqrcode_core 2.1.0 and rqrcode 3.2.0's `as_svg` (Rect output),
# for `QrCodeController#show` (reference/app/controllers/qr_code_controller.rb):
# `RQRCode::QRCode.new(url).as_svg(viewbox: true, fill: :white, color: :black)`.
#
# The output has to be byte-identical to the gem's, so this follows its
# algorithms rather than the QR spec's optimal choices: a single segment
# whose mode is numeric, alphanumeric or 8-bit byte (in that order of
# preference), error correction level H, the smallest version whose capacity
# is *strictly* greater than the segment's bits, and the mask with the fewest
# "lost points" as the gem scores them (including its floating-point
# dark-ratio term). Golden vectors: `reference-tools/campfire/rqrcode.rb`.
module controllers/qr_code/rqrcode

import std/int
import std/text

# `RQRCode::QRCode.new(data).as_svg(viewbox: true, fill: :white, color:
# :black)`, for the binary string `Base64.urlsafe_decode64` returns; nil when
# it doesn't fit a version 40 code.
pub def svg_bytes(data : String) : String?
  modules = qr_modules(data)
  return nil unless modules
  module_size = 11
  dimension = modules.size * module_size
  String.build(256 + modules.size * modules.size * 30) do |io|
    io << %(<?xml version="1.0" standalone="yes"?>)
    io << %(<svg version="1.1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:ev="http://www.w3.org/2001/xml-events" viewBox="0 0 #{dimension} #{dimension}" shape-rendering="crispEdges">)
    io << %(<rect width="#{dimension}" height="#{dimension}" x="0" y="0" fill="white"/>)
    modules.each_with_index do |cells, row|
      cells.each_with_index do |dark, col|
        io << %(<rect width="#{module_size}" height="#{module_size}" x="#{col * module_size}" y="#{row * module_size}" fill="black"/>) if dark
      end
    end
    io << "</svg>"
  end
end

# `RQRCodeCore::QRCode#modules`: the dark (true) and light modules, row by
# row; nil where rqrcode raises "Data length exceed maximum capacity of
# version 40".
pub def qr_modules(data : String) : Array(Array(Bool))?
  segment = Segment.new(data)
  version = minimum_version(segment)
  return nil unless version
  count = version * 4 + 17

  common = Grid.new(count)
  place_position_probe_pattern(common, 0, 0)
  place_position_probe_pattern(common, count - 7, 0)
  place_position_probe_pattern(common, 0, count - 7)
  place_position_adjust_pattern(common, version)
  place_timing_pattern(common)

  codewords = create_data(version, segment)

  # `get_best_mask_pattern`: the first pattern with the fewest lost points.
  best_pattern = 0
  best_points = 0.0
  8.times do |pattern|
    points = lost_points(make(common, version, codewords, true, pattern))
    if pattern == 0 || best_points > points
      best_pattern = pattern
      best_points = points
    end
  end
  make(common, version, codewords, false, best_pattern)
end

def make(common : Grid, version : Int32, codewords : Array(Int32), test : Bool, pattern : Int32) : Array(Array(Bool))
  grid = common.dup
  place_format_info(grid, test, pattern)
  place_version_info(grid, version, test) if version >= 7
  map_data(grid, codewords, pattern)
  grid.to_modules
end

enum Mode
  Number      = 1
  AlphaNumeric = 2
  Byte        = 4
end

ALPHANUMERIC = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ $%*+-./:"

# `QRERRORCORRECTLEVEL[:h]`
LEVEL_H = 2

# `QRMAXBITS[:h]`
MAX_BITS_H = [
  72, 128, 208, 288, 368, 480, 528, 688, 800, 976, 1120, 1264, 1440, 1576,
  1784, 2024, 2264, 2504, 2728, 3080, 3248, 3536, 3712, 4112, 4304, 4768,
  5024, 5288, 5608, 5960, 6344, 6760, 7208, 7688, 7888, 8432, 8768, 9136,
  9776, 10208,
]

# The H rows of `QRRSBlock::RS_BLOCK_TABLE`: (count, total, data) groups.
RS_BLOCKS_H = [
  [1, 26, 9],
  [1, 44, 16],
  [2, 35, 13],
  [4, 25, 9],
  [2, 33, 11, 2, 34, 12],
  [4, 43, 15],
  [4, 39, 13, 1, 40, 14],
  [4, 40, 14, 2, 41, 15],
  [4, 36, 12, 4, 37, 13],
  [6, 43, 15, 2, 44, 16],
  [3, 36, 12, 8, 37, 13],
  [7, 42, 14, 4, 43, 15],
  [12, 33, 11, 4, 34, 12],
  [11, 36, 12, 5, 37, 13],
  [11, 36, 12, 7, 37, 13],
  [3, 45, 15, 13, 46, 16],
  [2, 42, 14, 17, 43, 15],
  [2, 42, 14, 19, 43, 15],
  [9, 39, 13, 16, 40, 14],
  [15, 43, 15, 10, 44, 16],
  [19, 46, 16, 6, 47, 17],
  [34, 37, 13],
  [16, 45, 15, 14, 46, 16],
  [30, 46, 16, 2, 47, 17],
  [22, 45, 15, 13, 46, 16],
  [33, 46, 16, 4, 47, 17],
  [12, 45, 15, 28, 46, 16],
  [11, 45, 15, 31, 46, 16],
  [19, 45, 15, 26, 46, 16],
  [23, 45, 15, 25, 46, 16],
  [23, 45, 15, 28, 46, 16],
  [19, 45, 15, 35, 46, 16],
  [11, 45, 15, 46, 46, 16],
  [59, 46, 16, 1, 47, 17],
  [22, 45, 15, 41, 46, 16],
  [2, 45, 15, 64, 46, 16],
  [24, 45, 15, 46, 46, 16],
  [42, 45, 15, 32, 46, 16],
  [10, 45, 15, 67, 46, 16],
  [20, 45, 15, 61, 46, 16],
]

# `QRUtil::PATTERN_POSITION_TABLE`
PATTERN_POSITIONS = [
  [] of Int32,
  [6, 18],
  [6, 22],
  [6, 26],
  [6, 30],
  [6, 34],
  [6, 22, 38],
  [6, 24, 42],
  [6, 26, 46],
  [6, 28, 50],
  [6, 30, 54],
  [6, 32, 58],
