# `reference/app/models/boost.rb`: the row. Creating and destroying a boost
# touch its message, so those live with the message (`db/models/message`).
module models/boost

import rils/record/sqlite::{Connection, Row, SqlValue}
import rils/record/timestamp::{Timestamp}
import rils/record/database::{Tx}
import rils/record/errors::{RecordNotFound}

pub BOOST_COLUMNS = %("boosts"."id", "boosts"."message_id", "boosts"."booster_id", "boosts"."content", "boosts"."created_at", "boosts"."updated_at")

pub class Boost
  getter id : Int64
  getter message_id : Int64
  getter booster_id : Int64
  getter content : String
  getter created_at : Timestamp
  getter updated_at : Timestamp

  def initialize(@id : Int64, @message_id : Int64, @booster_id : Int64, @content : String, @created_at : Timestamp, @updated_at : Timestamp)
  end

  pub def self.from_row(row : Row, offset : Int32 = 0) : Boost
    Boost.new(row.int(offset), row.int(offset + 1), row.int(offset + 2), row.text(offset + 3), row.time(offset + 4), row.time(offset + 5))
  end

  pub def self.find(conn : Connection, id : Int64) : Boost | RecordNotFound
    conn.query_one(%(SELECT #{BOOST_COLUMNS} FROM "boosts" WHERE "boosts"."id" = ? LIMIT 1), [id] of SqlValue) { |row| Boost.from_row(row) } || RecordNotFound.new("Boost")
  end

  pub def self.for_message(conn : Connection, message_id : Int64) : Array(Boost)
    conn.query_all(%(SELECT #{BOOST_COLUMNS} FROM "boosts" WHERE "boosts"."message_id" = ?), [message_id] of SqlValue) { |row| Boost.from_row(row) }
  end

  # `message.boosts.ordered`
  pub def self.for_message_ordered(conn : Connection, message_id : Int64) : Array(Boost)
    conn.query_all(%(SELECT #{BOOST_COLUMNS} FROM "boosts" WHERE "boosts"."message_id" = ? ORDER BY "boosts"."created_at" ASC), [message_id] of SqlValue) { |row| Boost.from_row(row) }
  end

  # `message.boosts.find_by!(id:, booster:)`
  pub def self.find_by_message_and_booster(conn : Connection, message_id : Int64, id : Int64, booster_id : Int64) : Boost | RecordNotFound
    conn.query_one(%(SELECT #{BOOST_COLUMNS} FROM "boosts" WHERE "boosts"."message_id" = ? AND "boosts"."id" = ? AND "boosts"."booster_id" = ? LIMIT 1), [message_id, id, booster_id] of SqlValue) { |row| Boost.from_row(row) } || RecordNotFound.new("Boost")
  end

  # The insert alone; `create_boost` in `db/models/message` touches the
  # message too.
  pub def self.insert(tx : Tx, message_id : Int64, booster_id : Int64, content : String) : Boost
    now = tx.now
    id = tx.conn.query_one(%(INSERT INTO "boosts" ("booster_id", "content", "created_at", "message_id", "updated_at") VALUES (?, ?, ?, ?, ?) RETURNING "id"), [booster_id, content, now, message_id, now] of SqlValue) { |row| row.int(0) }
    raise "insert into boosts returned no id" unless id
    Boost.new(id, message_id, booster_id, content, now, now)
  end

  # The delete alone, for a message being destroyed (its touch is moot).
  pub def delete_row(tx : Tx) : Nil
    tx.conn.execute(%(DELETE FROM "boosts" WHERE "boosts"."id" = ?), [@id] of SqlValue)
  end
end
