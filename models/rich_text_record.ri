# `ActionText::RichText` rows (`action_text_rich_texts`). Campfire has one:
# `Message#body`.
module models/rich_text_record

import rils/record/sqlite::{Connection, Row, SqlValue}
import rils/record/timestamp::{Timestamp}
import rils/record/database::{Tx}

pub RICH_TEXT_COLUMNS = %("action_text_rich_texts"."id", "action_text_rich_texts"."name", "action_text_rich_texts"."body", "action_text_rich_texts"."record_type", "action_text_rich_texts"."record_id", "action_text_rich_texts"."created_at", "action_text_rich_texts"."updated_at")

pub class RichTextRecord
  getter id : Int64
  getter name : String
  getter body : String?
  getter record_type : String
  getter record_id : Int64
  getter created_at : Timestamp
  getter updated_at : Timestamp

  def initialize(@id : Int64, @name : String, @body : String?, @record_type : String, @record_id : Int64, @created_at : Timestamp, @updated_at : Timestamp)
  end

  pub def self.from_row(row : Row, offset : Int32 = 0) : RichTextRecord
    RichTextRecord.new(row.int(offset), row.text(offset + 1), row.text?(offset + 2), row.text(offset + 3), row.int(offset + 4), row.time(offset + 5), row.time(offset + 6))
  end

  pub def self.find_for(conn : Connection, record_type : String, record_id : Int64, name : String) : RichTextRecord?
    conn.query_one(%(SELECT #{RICH_TEXT_COLUMNS} FROM "action_text_rich_texts" WHERE "action_text_rich_texts"."record_id" = ? AND "action_text_rich_texts"."record_type" = ? AND "action_text_rich_texts"."name" = ? LIMIT 1), [record_id, record_type, name] of SqlValue) { |row| RichTextRecord.from_row(row) }
  end

  pub def self.create(tx : Tx, record_type : String, record_id : Int64, name : String, body : String) : RichTextRecord
    now = tx.now
    id = tx.conn.query_one(%(INSERT INTO "action_text_rich_texts" ("body", "created_at", "name", "record_id", "record_type", "updated_at") VALUES (?, ?, ?, ?, ?, ?) RETURNING "id"), [body, now, name, record_id, record_type, now] of SqlValue) { |row| row.int(0) }
    raise "insert into action_text_rich_texts returned no id" unless id
    RichTextRecord.new(id, name, body, record_type, record_id, now, now)
  end

  pub def update_body(tx : Tx, body : String) : Nil
    now = tx.now
    tx.conn.execute(%(UPDATE "action_text_rich_texts" SET "body" = ?, "updated_at" = ? WHERE "action_text_rich_texts"."id" = ?), [body, now, @id] of SqlValue)
    @body = body
    @updated_at = now
  end

  pub def delete(tx : Tx) : Nil
    tx.conn.execute(%(DELETE FROM "action_text_rich_texts" WHERE "action_text_rich_texts"."id" = ?), [@id] of SqlValue)
  end
end
