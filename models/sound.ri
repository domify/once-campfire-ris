# `reference/app/models/sound.rb`
module models/sound

pub struct SoundImage
  # `"sounds/#{name}"`
  getter name : String
  getter width : Int32
  getter height : Int32

  def initialize(@name : String, @width : Int32, @height : Int32)
  end

  pub def asset_path : String
    "sounds/#{@name}"
  end
end

pub struct Sound
  getter name : String
  getter text : String?
  getter image : SoundImage?

  def initialize(@name : String, @text : String?, @image : SoundImage?)
  end

  # `"#{name}.mp3"`
  pub def asset_path : String
    "#{@name}.mp3"
  end

  pub def self.find_by_name(name : String) : Sound?
    BUILTIN_SOUNDS.find { |sound| sound.name == name }
  end

  # `Sound.names`: sorted.
  pub def self.names : Array(String)
    BUILTIN_SOUNDS.map(&.name).sorted
  end
end

