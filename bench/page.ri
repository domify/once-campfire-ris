  buf.append("/boosts\" accept-charset=\"UTF-8\" method=\"post\">\n            <input type=\"hidden\" name=\"boost[content]\" id=\"boost_content\" value=\"👍\" />\n            <button name=\"button\" type=\"submit\" title=\"Thumbs up\" class=\"btn message__action-btn\" data-emoji=\"👍\">\n              <figure class=\"margin-none boost-character\">👍</figure>\n              <span class=\"for-screen-reader\">Thumbs up</span>\n</button></form>\n          <form data-turbo-frame=\"boosting_message_")
