# Outbound HTTP over curl against a local server: a webhook's reply, a
# gzipped body, a timeout answered with the timeout text, and a refused
# connection.
module test/integrations/net_live_test

import std/text
import web/web/router::{Router, RouteHandler}
import web/web/handler::{chain}
import web/web/server::{Server}
import web/web/config::{Config}
import integrations/net::{Http, HttpAnswer, NetError}
import integrations/bot_webhook::{deliver, WebhookReply, WebhookError}
import web/web/spec::*

router = Router.new
router.post "/text" do |env|
  env.response.headers["Content-Type"] = "text/plain"
  "Hello back! #{env.request.body}"
end
router.post "/slow" do |env|
  sleep(9000)
  "late"
end

def serving(router : Router, &block : Server -> Nil) : Nil
  server = Server.new(chain([RouteHandler.new(router)]), Config.new)
  server.bind("127.0.0.1", 0)
  group do |g|
    g.spawn do
      server.listen
      0
    end
    g.spawn do
      block.call(server)
      server.shutdown(0)
      0
    end
  end
end

describe "outbound HTTP" do
  it "posts a webhook, times out, and fails on a refused connection" do
    serving(router) do |server|
      http = Http.new
      base = "http://127.0.0.1:#{server.bound_port}"
      reply = deliver(http, "#{base}/text", %({"message":"hi"}))
      raise reply.message if reply.is_a?(WebhookError)
      assert reply.text == %(Hello back! {"message":"hi"})
      slow = deliver(http, "#{base}/slow", "{}")
      raise slow.message if slow.is_a?(WebhookError)
      assert slow.text == "Failed to respond within 7 seconds"
      refused = deliver(http, "http://127.0.0.1:1/text", "{}")
      assert refused.is_a?(WebhookError)
      pinned = http.request("GET", "http://campfire.invalid:#{server.bound_port}/text", "127.0.0.1")
      raise pinned.inspect unless pinned.is_a?(HttpAnswer)
      assert pinned.status == 404 || pinned.status == 405
    end
  end
end
