# The private network guard, classified like surfguard.
module test/integrations/net_test

import rils/ruby/ipaddr::{parse_ipaddr}
import integrations/net::*
import web/web/spec::*

def blocked(ip : String) : Bool
  blocked_address?(parse_ipaddr(ip) || raise "bad #{ip}")
end

describe "the private network guard" do
  it "classifies addresses like surfguard" do
    ["0.0.0.0", "10.1.2.3", "100.64.0.1", "127.0.0.1", "168.63.129.16", "169.254.169.254", "172.16.0.0", "172.31.255.255",
     "192.0.0.8", "192.0.2.1", "192.88.99.1", "192.168.1.1", "198.18.0.1", "198.51.100.1", "203.0.113.1", "224.0.0.1", "240.0.0.1",
     "255.255.255.255", "::", "::1", "::ffff:192.168.1.1", "::ffff:8.8.8.8", "::8.8.8.8", "64:ff9b::a00:1", "64:ff9b:1::1",
     "::ffff:0:a00:1", "fc00::1", "fd00::1", "fe80::1", "fec0::1", "ff02::1", "2001::1", "2001:db8::1", "2002::1", "3fff::1",
     "5f00::1", "100::1", "2001:2::1", "4000::1", "2001:10::1"].each { |ip| assert blocked(ip), "#{ip} should be blocked" }
    ["8.8.8.8", "1.1.1.1", "93.184.216.34", "142.250.185.206", "172.32.0.1", "100.128.0.1", "2606:4700:4700::1111",
     "2001:4860:4860::8888", "64:ff9b::808:808"].each { |ip| assert !blocked(ip), "#{ip} should be allowed" }
  end

  it "resolves names, and numeric hosts without asking" do
    asked = [] of String
    lookup = ->(host : String) { asked << host; host == "example.com" ? ["10.0.0.1", "93.184.216.34", "2606:4700:4700::1111"] : nil.as(Array(String)?) }
    assert guard_resolve(lookup, "example.com") == "93.184.216.34"
    assert guard_resolve(lookup, "8.8.8.8") == "8.8.8.8"
    assert guard_resolve(lookup, "0x7f.1").is_a?(GuardError)
    assert guard_resolve(lookup, "127.0.0.1").is_a?(GuardError)
    assert guard_resolve(lookup, "nowhere.test").is_a?(GuardError)
    assert guard_resolve(lookup, "bad_host.com").is_a?(GuardError)
    assert asked == ["example.com", "nowhere.test"]
  end

  it "splits URLs" do
    assert split_url("https://example.com/a?b") == {"https", "example.com", 443}
    assert split_url("http://[::1]:8080/") == {"http", "::1", 8080}
    assert split_url("ftp://x").nil?
  end
end
