# A user as the sidebar shows them: a face and a first name.
pub class SidebarUser
  getter id : Int64
  getter name : String
  # `fresh_user_avatar_path(user)`.
  getter avatar_path : String

  def initialize(@id : Int64, @name : String, @avatar_path : String)
  end

  # `name.split(' ')`: runs of ASCII whitespace part the words.
  def name_parts : Array(String)
    parts = [] of String
    word = String::Builder.new
    empty = true
    @name.each_char do |char|
      if char.ord < 128 && space?(char.ord.to_u8)
        parts << word.to_s unless empty
        word = String::Builder.new
        empty = true
      else
        word << char
        empty = false
      end
    end
    parts << word.to_s unless empty
    parts
  end

  # `name.split(' ')[0]`.
  def first_name : String
    parts = name_parts
    parts.empty? ? "" : parts[0]
  end
end

# A direct room in the sidebar (`users/sidebars/rooms/_direct`): its other
# members, or the user alone in it.
pub class SidebarDirect
  getter room_id : Int64
  getter unread : Bool
  # `room.updated_at.to_fs(:epoch)`.
  getter updated_at_epoch : String
  getter members : Array(SidebarUser)

  def initialize(@room_id : Int64, @unread : Bool, @updated_at_epoch : String, @members : Array(SidebarUser))
  end

  def class_names : String
    @unread ? "direct unread" : "direct"
  end

  # `members.map { |m| m.name.split(' ')[0, 3].map { |s| s[0].capitalize }.join }.to_sentence(two_words_connector: '+')`.
  def member_initials : String
    initials = @members.map { |member| member.name_parts.first(3).map { |part| capitalize(part[0].to_s) }.join }
    to_sentence(initials, "+")
  end
end

# `users/sidebars/rooms/_direct.html.erb` on its own, for the broadcast
# that adds a new direct room to its members' sidebars.
