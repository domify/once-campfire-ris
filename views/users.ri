# A shared room in the sidebar (`users/sidebars/rooms/_shared`).
pub class SidebarRoom
  getter id : Int64
  # "rooms_open" or "rooms_closed".
  getter param_key : String
  getter name : String
  getter unread : Bool

  def initialize(@id : Int64, @param_key : String, @name : String, @unread : Bool)
  end

  def class_names : String
    @unread ? "align-center gap room btn txt-nowrap unread" : "align-center gap room btn txt-nowrap"
  end
end

