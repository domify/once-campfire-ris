# What a mention shows of its user.
pub class MentionUser
  getter id : Int64
  getter name : String
  getter bio : String?
  getter attachable_sgid : String
  getter avatar_path : String

  def initialize(@id : Int64, @name : String, @bio : String?, @attachable_sgid : String, @avatar_path : String)
  end

  # What `avatar_tag(user)` needs: `User#title` and the avatar path.
  def avatar : AvatarUser
    AvatarUser.new(@id, user_title(@name, @bio), @avatar_path)
  end
end

# `users/_mention.html.erb`.
pub class Mention
  getter ctx : ViewContext
  getter user : MentionUser

  def initialize(@ctx : ViewContext, @user : MentionUser)
  end

  Template.def_render("users/_mention.html.erb")
end

# What the ban button needs of its user.
pub class BanUser
  getter id : Int64
  getter name : String
  getter status : String

  def initialize(@id : Int64, @name : String, @status : String)
  end

  # `User#active?`.
  def active : Bool
    @status == "active"
  end
end

