end

# `users/sidebars/show.html.erb`: the rooms and directs of `Current.user`
# (*current_user*), which the layout's sidebar frame loads.
pub class SidebarShow
  getter ctx : ViewContext
  getter current_user : SidebarUser
  getter rooms_stream : String
  getter user_rooms_stream : String
  getter direct_memberships : Array(SidebarDirect)
  getter direct_placeholder_users : Array(SidebarUser)
  getter other_memberships : Array(SidebarRoom)
  # `Current.user.administrator? || !restrict_room_creation_to_administrators?`.
  getter can_create_rooms : Bool

  def initialize(@ctx : ViewContext, @current_user : SidebarUser, @rooms_stream : String, @user_rooms_stream : String,
                 @direct_memberships : Array(SidebarDirect), @direct_placeholder_users : Array(SidebarUser),
                 @other_memberships : Array(SidebarRoom), @can_create_rooms : Bool)
  end

  Template.def_page("users/sidebars/show.html.erb")

  pub def page(frame : Bool = false) : RecordedPage
    render_in_layout(@ctx, nil, nil, frame) { |buffer| render_into(buffer) }
  end
end

# A user's profile as `users/show` shows it.
pub class ShownUser
  getter id : Int64
  getter name : String
  getter bio : String?
  getter email_address : String?
  # "administrator", "member" or "bot".
  getter role : String
  # "active", "deactivated" or "banned".
  getter status : String
  getter avatar_path : String
  # `user.transfer_id`, for `users/profiles/_transfer`.
  getter transfer_id : String

  def initialize(@id : Int64, @name : String, @bio : String?, @email_address : String?, @role : String, @status : String, @avatar_path : String, @transfer_id : String)
  end

  def bot? : Bool
    @role == "bot"
  end

  # `active?`, as `users/_ban_button` asks it.
  def active : Bool
    @status == "active"
  end

  def deactivated? : Bool
    @status == "deactivated"
  end

  def banned? : Bool
    @status == "banned"
  end
end

# `users/show.html.erb`: someone's profile.
pub class Show
  getter ctx : ViewContext
  getter user : ShownUser

  def initialize(@ctx : ViewContext, @user : ShownUser)
  end

  Template.def_page("users/show.html.erb")

  pub def page(frame : Bool = false) : RecordedPage
    render_in_layout(@ctx, @user.name, nil, frame) { |buffer| render_into(buffer) }
  end
end

# A room in the profile's list (`users/profiles/_membership`), with the
# user's involvement in it.
pub class ProfileMembership
  getter room_id : Int64
  # `model_name.param_key` of the room's class.
  getter room_param_key : String
  getter room_display_name : String
  getter involvement : String
  getter direct : Bool

  def initialize(@room_id : Int64, @room_param_key : String, @room_display_name : String, @involvement : String, @direct : Bool)
  end

  def involvement_room : InvolvementRoom
    InvolvementRoom.new(@room_id, @room_param_key, @direct)
  end
end

# `users/profiles/show.html.erb`: `Current.user`'s own profile and rooms.
pub class ProfileShow
  getter ctx : ViewContext
  getter user : ShownUser
  getter avatar_attached : Bool
  getter shared_memberships : Array(ProfileMembership)
  getter direct_memberships : Array(ProfileMembership)

  def initialize(@ctx : ViewContext, @user : ShownUser, @avatar_attached : Bool, @shared_memberships : Array(ProfileMembership), @direct_memberships : Array(ProfileMembership))
  end

  Template.def_page("users/profiles/show.html.erb")

  # `form_with model: @user, url: user_profile_path, method: :patch, data: { controller: "form" }`.
  def profile_form : FormWith
    form_with(user_profile_path).model("user").method("patch").data("controller", "form")
  end

  # The email field's leading options: its value only when there is one.
  def email_options : Attrs
    options = attrs.class("input txt-large")
    if email_address = @user.email_address
      options = options.attr("value", email_address)
    end
    options
  end

  pub def page(frame : Bool = false) : RecordedPage
    render_in_layout(@ctx, @user.name, nil, frame) { |buffer| render_into(buffer) }
  end
end

