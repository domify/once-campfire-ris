<%# reference/app/views/users/new.html.erb %>
<% content_for "nav" do %>  <div class="flex-item-justify-end">
    <%= link_to(new_session_path, attrs.class("btn flex-item-justify-end")) do %>
      <%= image_tag(ctx, "login-keys.svg", attrs.aria_hidden) %>
      <span class="for-screen-reader">Sign in</span>
<% end %>  </div>
<% end %>
<% form = form_with(join_path(join_code)).model("user").multipart.class("center") %><%= form.wrap do %>
  <section class="nametag u-relative">
    <div class="flex justify-center align-center pad-block">
      <%= image_tag(ctx, "lanyard.svg", attrs.class("nametag__lanyard").aria_hidden) %>
    </div>

    <div class="nametag__inner flex flex-column gap">
      <fieldset class="flex flex-column center-block">
        <legend class="txt-align-center flex gap">
          <%= account_logo_tag(ctx) %>
          <strong class="txt-large"><%= ctx.account.name %></strong>
        </legend>

        <label class="align-center center avatar__form gap" data-controller="upload-preview">
          <div class="btn input--file">
            <%= image_tag(ctx, "camera.svg", attrs.aria_hidden) %>
            <%= form.file_field("avatar", attrs.class("input").accept("image/*").data("upload_preview_target", "input").data("action", "upload-preview#previewImage")) %>
            <span class="for-screen-reader">Upload avatar</span>
          </div>

          <div class="btn avatar input--file txt-xx-large">
            <%= image_tag(ctx, "default-avatar.svg", attrs.aria_hidden.data("upload_preview_target", "image")) %>
            <span class="for-screen-reader">Avatar</span>
          </div>
        </label>
      </fieldset>

      <div class="flex align-center gap">
        <%= translation_button(ctx, "user_name") %>
        <label class="flex align-center gap flex-item-grow txt-large input input--actor">
          <%= form.text_field("name", nil, attrs.class("input").autocomplete("name").placeholder("Name").autofocus.required(true).data("1p-ignore", true)) %>
          <%= image_tag(ctx, "person.svg", attrs.aria_hidden.size(24).class("colorize--black")) %>
        </label>
      </div>

      <div class="flex align-center gap">
        <%= translation_button(ctx, "email_address") %>
        <label class="flex align-center gap flex-item-grow txt-large input input--actor">
          <%= form.email_field("email_address", nil, attrs.class("input").autocomplete("username").placeholder("Email address").required(true)) %>
          <%= image_tag(ctx, "email.svg", attrs.aria_hidden.size(24).class("colorize--black")) %>
        </label>
      </div>

      <div class="flex align-center gap">
        <%= translation_button(ctx, "password") %>
        <label class="flex align-center gap flex-item-grow txt-large input input--actor">
          <%= form.password_field("password", attrs.class("input").autocomplete("new-password").placeholder("Password").required(true).maxlength(72)) %>
          <%= image_tag(ctx, "password.svg", attrs.aria_hidden.size(24).class("colorize--black")) %>
        </label>
      </div>

      <%= button_tag(attrs.class("btn btn--reversed center txt-large").type("submit")) do %>
        <%= image_tag(ctx, "check.svg", attrs.aria_hidden) %>
        <span class="for-screen-reader">Save</span>
<% end %>    </div>
  </section>
<% end %>
<% include "accounts/_help_contact.html.erb" %>

