<%# reference/app/views/users/sidebars/rooms/_direct.html.erb. The reference wraps this in `cache membership do` and assigns `members` on lines Erubi drops, leaving the blank line and indentation below. %>
  <%= link_to_room(membership.room_id, attrs.class(membership.class_names).id(dom_id("rooms_direct", membership.room_id, "list")).data("sorted_list_number", membership.updated_at_epoch)) do %>
<% if membership.members.size > 1 %>      <div class="avatar__group">
<% membership.members.first(4).each do |member| %>          <span class="avatar">
            <%= image_tag(ctx, member.avatar_path, attrs.size(20).aria_hidden) %>
          </span>
<% end %>      </div>
<% else %>      <span class="avatar">
        <%= image_tag(ctx, membership.members[0].avatar_path, attrs.size(48).aria_hidden) %>
      </span>
<% end %>
    <span class="direct__author flex align-center gap max-width min-width border-radius txt-small">
      <span class="txt-nowrap overflow-ellipsis">
        <span class="for-screen-reader">Ping with</span>
<% if membership.members.size > 1 %>          <%= membership.member_initials %>
<% else %>          <%= membership.members[0].first_name %>
<% end %>      </span>
    </span>
<% end %>
