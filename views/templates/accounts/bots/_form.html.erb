<%# reference/app/views/accounts/bots/_form.html.erb -%>
<h1 class="for-screen-reader">Chat Bot Setup</h1>
<label class="align-center center avatar__form gap" data-controller="upload-preview">
  <div class="btn input--file">
    <%= image_tag(ctx, "camera.svg", attrs.aria_hidden.size(20)) %>
    <%= form.file_field("avatar", attrs.class("input").accept("image/*").data("upload_preview_target", "input").data("action", "upload-preview#previewImage")) %>
    <span class="for-screen-reader">Upload bot avatar</span>
  </div>

  <div class="avatar input--file txt-xx-large" style="--avatar-size: var(--btn-size);">
    <%= image_tag(ctx, bot.avatar_attachment_url || "default-bot-avatar.svg", attrs.alt("Bot avatar").size(48).data("upload_preview_target", "image")) %>
  </div>
</label>

<div class="flex align-center gap">
  <%= translation_button(ctx, "bot_name") %>
  <label class="flex align-center gap flex-item-grow txt-large input input--actor">
    <%= form.text_field("name", bot.name, attrs.class("input").autocomplete("name").placeholder("Name the bot").autofocus.required(true).data("1p-ignore", true)) %>
    <%= image_tag(ctx, "bot.svg", attrs.aria_hidden.size(24).class("colorize--black")) %>
  </label>
</div>

<div class="flex align-center gap">
  <%= translation_button(ctx, "webhook_url") %>
  <label class="flex align-center gap flex-item-grow txt-large input input--actor">
    <%= form.url_field("webhook_url", bot.webhook_url, attrs.class("input").placeholder("Webhook URL")) %>
    <%= image_tag(ctx, "web.svg", attrs.aria_hidden.size(24).class("colorize--black")) %>
  </label>
</div>

<%= profile_form_submit_button(ctx) %>

