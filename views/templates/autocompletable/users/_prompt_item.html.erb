<%# reference/app/views/autocompletable/users/_prompt_item.html.erb -%>
<lexxy-prompt-item search="<%= user.name %>" sgid="<%= user.attachable_sgid %>">
  <template type="menu">
    <span class="autocomplete__item flex align-center gap unpad">
      <%= avatar_tag(ctx, user.avatar) %>
      <span class="autocompletable__name"><%= user.name %></span>
    </span>
  </template>
  <template type="editor">
    <%= Mention.new(ctx, user).render %>
  </template>
</lexxy-prompt-item>

