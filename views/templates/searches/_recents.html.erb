<%# The recent-searches links reference/app/views/searches/index.html.erb repeats in its nav and sidebar -%>
<% recent_searches.each do |search| %>      <a class="align-center gap room btn txt-nowrap" href="<%= search_path(search) %>">
        <span class="overflow-ellipsis">“<%= search %>”</span>
</a>
<% end %><% unless recent_searches.empty? %>      <form class="button_to" method="post" action="<%= ctx.url(clear_searches_path) %>"><input type="hidden" name="_method" value="delete" /><button class="btn searches__btn" data-turbo-confirm="Are you sure you want to clear your recent searches?" type="submit">
        <img aria-hidden="true" src="<%= ctx.asset("broom.svg") %>" />
        <span class="for-screen-reader">Clear recent searches</span>
</button></form>
<% end %>
