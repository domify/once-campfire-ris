<%# reference/app/views/rooms/show/_nav.html.erb -%>
  <%- if ctx.account.has_logo %>
  <%= account_logo_tag(ctx, nil) %>
  <%- end %>

  <span class="btn btn--reversed btn--faux room--current">
    <h1 class="room__contents txt-medium overflow-ellipsis">
      <%- if room.direct? %>
        <span class="for-screen-reader">Ping with</span>
      <%- end %>

      <%= room.display_name %>
    </h1>
</span>

  <a class="btn" style="view-transition-name: edit-room-<%= room.id %>" data-room-id="<%= room.id %>" href="<%= room.edit_path %>">
    <img aria-hidden="true" src="<%= ctx.asset("menu-dots-horizontal.svg") %>" width="20" height="20" />
    <span class="for-screen-reader">Settings for this <%= room.noun %></span>
</a>

  <% include "rooms/involvements/_bell.html.erb" %>
