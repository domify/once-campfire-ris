<%# reference/app/views/rooms/closeds/_form.html.erb -%>
<% include "rooms/layouts/_form_start.html.erb" %>
    <%= user_filter_menu_tag do %>
<% if can_administer %>      <li class="flex align-center gap margin-none">
        <figure class="avatar flex-item-no-shrink" style="--avatar-border-radius: 0; --avatar-size: 4ch;">
          <img aria-hidden="true" class="colorize--black" style="background-color: transparent" src="<%= ctx.asset("everyone.svg") %>" />
          <span class="for-screen-reader">Everyone</span>
        </figure>

        <div class="min-width">
          <div class="overflow-ellipsis fill-shade"><strong>Everyone</strong></div>
        </div>

        <hr class="separator" aria-hidden="true">

        <a class="btn--faux flex-inline" tabindex="-1" data-turbo-action="replace" href="<%= type_change_path %>">
          <label for="room_type" class="switch">
            <input type="checkbox" id="room_type" class="switch__input">
            <span class="switch__btn round"></span>
            <span class="for-screen-reader">Give everyone access to this room</span>
          </label>
</a>
      </li>

      <hr class="separator full-width" style="--border-style: solid">
<% end %><% if selected_users.size + unselected_users.size > 20 %>    <%= user_filter_search_tag %>
<% end %>
    <div data-filter-target="list" contents>
<% selected = true %><% selected_users.each do |user| %>      <% include "rooms/closeds/_user.html.erb" %>
<% end %><% if !selected_users.empty? && !unselected_users.empty? %>        <hr class="separator full-width" style="--border-style: solid">
<% end %><% selected = false %><% unselected_users.each do |user| %>      <% include "rooms/closeds/_user.html.erb" %>
<% end %>    </div>
<% end %>
<% include "rooms/layouts/_form_end.html.erb" %>
