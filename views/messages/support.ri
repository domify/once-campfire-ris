# Small Ruby/Rails behaviors the message and room views depend on: time
# formats and numbers as Ruby prints them.
module views/messages/support

import std/time::{Time}
import rils/ruby/floats::{to_f, float_to_s}

# `time.iso8601` for a UTC `ActiveSupport::TimeWithZone`: seconds precision,
# `Z` suffix.
pub def iso8601(time : Time) : String
  "#{Time.pad4(time.year)}-#{Time.pad2(time.month)}-#{Time.pad2(time.day)}T#{Time.pad2(time.hour)}:#{Time.pad2(time.minute)}:#{Time.pad2(time.second)}Z"
end

# `time.to_fs(:epoch)`, defined in `config/initializers/time_formats.rb` as
# `(time.to_f * 1000).to_i`. The float round trip is deliberate: it
# truncates some millisecond values down by one, and the client compares
# these numbers. `Time#to_f` is the nearest double to the exact rational,
# which parsing the decimal representation gives.
pub def epoch_ms(time : Time) : Int64
  seconds = time.seconds
  nanos = time.nanoseconds
  decimal = if seconds < 0 && nanos != 0
              whole = seconds + 1
              "#{whole == 0 ? "-" : ""}#{whole}.#{Time.pad9(1_000_000_000 - nanos)}"
            else
              "#{seconds}.#{Time.pad9(nanos)}"
            end
  (to_f(decimal) * 1000.0).to_i64
end

# `time.as_json` with Active Support's default precision:
# `2026-09-26T12:26:46.848Z`.
pub def json_time(time : Time) : String
  "#{Time.pad4(time.year)}-#{Time.pad2(time.month)}-#{Time.pad2(time.day)}T#{Time.pad2(time.hour)}:#{Time.pad2(time.minute)}:#{Time.pad2(time.second)}.#{Time.pad3(time.nanoseconds // 1_000_000)}Z"
end

# A number as Ruby prints it: integers bare, floats as `Float#to_s` writes
# them, always with a fractional part (`600.0`) and in exponent form outside
# `1e-4..1e15` (`1.0e+15`).
pub class RubyNumber
  getter value : Int64 | Float64

  def initialize(@value : Int64 | Float64)
  end

  def to_f : Float64
    value = @value
    value.is_a?(Int64) ? value.to_f : value
  end

  def float? : Bool
    @value.is_a?(Float64)
  end

  # `number / 2`: integer division for integers.
  def half : RubyNumber
    value = @value
    if value.is_a?(Int64)
      RubyNumber.new(value // 2)
    else
      RubyNumber.new(value / 2.0)
    end
  end

  def to_s : String
    value = @value
    value.is_a?(Int64) ? value.to_s : float_to_s(value)
  end

  def ==(other : RubyNumber) : Bool
    @value == other.value
  end
end
