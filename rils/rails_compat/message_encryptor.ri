# `ActiveSupport::MessageEncryptor` with `aes-256-gcm`, as the encrypted
# cookie jar builds it:
# `<base64 ciphertext>--<base64 12-byte IV>--<base64 16-byte auth tag>`,
# strict Base64, empty auth data, no separate signature.
module rils/rails_compat/message_encryptor

import std/time::{Time}
import rils/rails_compat/json::{Value}
import rils/rails_compat/crypto::{gcm_encrypt, gcm_decrypt, random_bytes}
import rils/rails_compat/encoding::{strict_encode, strict_decode}
import rils/rails_compat/metadata::{Failure, Serializer, serialize_with_metadata, deserialize_with_metadata}

IV_LENGTH       = 12
AUTH_TAG_LENGTH = 16
# Strict Base64 lengths of the IV and auth tag (with padding).
ENCODED_IV_LENGTH       = 16
ENCODED_AUTH_TAG_LENGTH = 24

pub class MessageEncryptor
  @secret : String
  @serializer : Serializer

  # *secret* must be 32 bytes (`key_generator.generate_key(salt, 32)`).
  def initialize(@secret : String, @serializer : Serializer)
    raise "aes-256-gcm needs a 32-byte key" unless @secret.bytesize == 32
  end

  pub def encrypt_and_sign(value : Value, purpose : String? = nil, expires_at : Time? = nil) : String
    plaintext = serialize_with_metadata(@serializer, value, purpose, expires_at)
    encrypt_with_iv(plaintext, random_bytes(IV_LENGTH))
  end

  def encrypt_with_iv(plaintext : String, iv : String) : String
    ciphertext, tag = gcm_encrypt(@secret, iv, plaintext)
    "#{strict_encode(ciphertext)}--#{strict_encode(iv)}--#{strict_encode(tag)}"
  end

  pub def decrypt_and_verify(message : String, purpose : String?, now : Time) : Value | Failure
    plaintext = decrypt(message)
    return Failure::InvalidSignature unless plaintext
    deserialize_with_metadata(@serializer, plaintext, purpose, now, false)
  end

  # The decrypted bytes, before any envelope handling.
  pub def decrypt(message : String) : String?
    tag_start = message.bytesize - ENCODED_AUTH_TAG_LENGTH
    iv_start = tag_start - 2 - ENCODED_IV_LENGTH
    ciphertext_end = iv_start - 2
    return nil if ciphertext_end < 0
    return nil unless message[tag_start - 2, 2] == "--" && message[ciphertext_end, 2] == "--"
    ciphertext = strict_decode(message[0, ciphertext_end])
    iv = strict_decode(message[iv_start, ENCODED_IV_LENGTH])
    tag = strict_decode(message[tag_start, ENCODED_AUTH_TAG_LENGTH])
    return nil unless ciphertext && iv && tag
    return nil unless iv.bytesize == IV_LENGTH && tag.bytesize == AUTH_TAG_LENGTH
    gcm_decrypt(@secret, iv, ciphertext, tag)
  end
end
