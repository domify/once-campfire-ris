# Golden-vector checks against `vectors/rails_compat.json` (generated by the
# reference app with `reference-tools/rails_compat_vectors.rb`). Each check
# lists every case it gets wrong, not just the first.
module rils/rails_compat/golden_test

import std/file::{File}
import std/json::{JSON, Any}
import std/time::{Time, Span}
import std/text
import rils/rails_compat/json::{Value, generate, encode}
import rils/rails_compat/clock::{parse_timestamp}
import rils/rails_compat/crypto::{hex}
import rils/rails_compat/key_generator::{Secrets}
import rils/rails_compat/metadata::{Serializer, Failure, serialize_with_metadata}
import rils/rails_compat/cookies::*
import rils/rails_compat/global_id::*
import rils/rails_compat/signed_id::*
import rils/rails_compat/turbo::*
import rils/rails_compat/password::*
import rils/rails_compat/app_verifier::{app_verifier}
import rils/rails_compat/content_disposition::{content_disposition}

VECTORS = JSON.parse(File.read("#{__DIR__}/../../vectors/rails_compat.json"))
SECRETS = Secrets.new(VECTORS["secret_key_base"].as_s)

class Mismatches
  getter lines : Array(String)

  def initialize
    @lines = [] of String
  end

  def check(label : String, ours : String, theirs : String) : Nil
    @lines << "#{label}: ours #{ours.inspect}, Rails' #{theirs.inspect}" unless ours == theirs
  end

  def check(label : String, ok : Bool) : Nil
    @lines << label unless ok
  end
end

def v(path : String) : Any
  value = VECTORS
  path.split('.').each { |key| value = value[key] }
  value
end

def time(value : Any) : Time
  parse_timestamp(value.as_s) || raise "not a time: #{value.as_s}"
end

def opt_time(value : Any) : Time?
  text = value.as_s?
  text ? time(value) : nil
end

def label(item : Any) : String
  field = item.as_h["case"]?
  "case #{((field ? field.as_s? : nil) || "").inspect}"
end

def shown(value : Value?) : String
  value ? generate(value) : "null"
end

failures = Mismatches.new
now = time(v("now"))

v("key_generator").as_a.each do |item|
  key = SECRETS.key_generator.generate_key(item["salt"].as_s, item["length"].as_i)
  failures.check("key #{item["salt"].as_s}", hex(key), item["key_hex"].as_s)
end

v("cookie_escaping").as_a.each do |item|
  if raw = item["raw"].as_s?
    failures.check("escape #{raw.inspect}", escape(raw), item["wire"].as_s)
  end
  failures.check("unescape #{item["wire"].as_s}", unescape(item["wire"].as_s), item["parsed"].as_s)
end

JSON.parse(File.read("#{__DIR__}/../../vectors/ruby_core.json"))["strings"].as_a.each do |item|
  raw = item["input"].as_s
  failures.check("rack escape #{raw.inspect}", escape(raw), item["rack_escape"].as_s)
end

v("signed_cookies.generate").as_a.each do |item|
  raw = sign(SECRETS, item["name"].as_s, item["value"].as_s, opt_time(item["expires_at"]))
  failures.check("sign #{item["value"].as_s}", raw, item["raw"].as_s)
  wire = item["set_cookie"].as_s.split(';')[0].partition('=')[2]
  failures.check("escaped #{item["value"].as_s}", escape(raw), wire)
end

session_token = v("signed_cookies.generate").as_a[0]
failures.check("permanent", permanent_expires_at(now).to_unix.to_s, time(session_token["expires_at"]).to_unix.to_s)

v("signed_cookies.verify").as_a.each do |item|
  value = verify_signed_value(SECRETS, item["name"].as_s, item["raw"].as_s, time(item["now"]))
  failures.check("signed #{label(item)}", shown(value), generate(item["expected"]))
  text = verify_signed(SECRETS, item["name"].as_s, item["raw"].as_s, time(item["now"]))
  failures.check("signed string #{label(item)}", text.inspect, item["expected"].as_s?.inspect)
end

v("encrypted_cookies.verify").as_a.each do |item|
  value = decrypt(SECRETS, item["name"].as_s, item["raw"].as_s, time(item["now"]))
  failures.check("encrypted #{label(item)}", shown(value), generate(item["expected"]))
end

encryptor = encrypted_cookie_encryptor(SECRETS)
v("encrypted_cookies.generate").as_a.each do |item|
  plaintext = encryptor.decrypt(item["raw"].as_s)
  failures.check("plaintext of #{item["name"].as_s}", plaintext || "(none)", item["plaintext"].as_s)
  ours = serialize_with_metadata(Serializer::Null, Any.new(encode(item["value"])), "cookie.#{item["name"].as_s}", opt_time(item["expires_at"]))
  failures.check("our plaintext of #{item["name"].as_s}", ours, item["plaintext"].as_s)
  raw = encrypt(SECRETS, item["name"].as_s, item["value"], opt_time(item["expires_at"]))
  failures.check("round trip of #{item["name"].as_s}", shown(decrypt(SECRETS, item["name"].as_s, raw, now)), generate(item["value"]))
end

session = v("session")
failures.check("session statuses", session["post_with_form_token_status"].as_i == 302 && session["post_with_bad_token_status"].as_i == 422)
failures.check("session", shown(decrypt(SECRETS, "_campfire_session", session["session_cookie_raw"].as_s, now)), generate(session["session"]))
token = session["session_token_value"].as_s
failures.check("session token", verify_signed(SECRETS, "session_token", session["session_token_raw"].as_s, now) || "(none)", token)
failures.check("session token signed", sign(SECRETS, "session_token", token, permanent_expires_at(now)), session["session_token_raw"].as_s)

v("signed_ids.generate").as_a.each do |item|
  generated = generate_signed_id(SECRETS, item["model"].as_s, item["id"].as_i64, item["purpose"].as_s?, opt_time(item["expires_at"]))
  failures.check("signed id #{item["model"].as_s} #{item["id"].as_i64} #{item["purpose"].as_s?}", generated, item["signed_id"].as_s)
end

v("signed_ids.verify").as_a.each do |item|
  id = verify_signed_id(SECRETS, item["model"].as_s, item["signed_id"].as_s, item["purpose"].as_s?, time(item["now"]))
  expected = item["expected"].as_s? ? item["expected"].as_s.to_i64 : item["expected"].as_i64?
  failures.check("verify signed id #{label(item)}", id.inspect, expected.inspect)
end

v("global_ids").as_a.each do |item|
  gid = GlobalId.parse(item["gid"].as_s)
  if gid
    failures.check("gid #{item["gid"].as_s}", gid == GlobalId.new(item["model_name"].as_s, item["id"].as_s))
    failures.check("gid to_s", gid.to_s, item["gid"].as_s)
    failures.check("gid param", gid.to_param, item["param"].as_s)
  else
    failures.check("gid #{item["gid"].as_s} parses", false)
  end
end

failures.check("sgid app", v("sgids.app").as_s, GID_APP)
v("sgids.generate").as_a.each do |item|
  gid = GlobalId.parse(item["gid"].as_s) || raise "unparsable gid"
  data = item["data"].as_s
  generated = if data.ends_with?("?expires_in")
                attachable_sgid(SECRETS, gid)
              else
                sgid(SECRETS, gid, item["purpose"].as_s, opt_time(item["expires_at"]))
              end
  failures.check("sgid #{data} for #{item["purpose"].as_s}", generated, item["sgid"].as_s)
end

v("sgids.verify").as_a.each do |item|
  located = locate_signed(SECRETS, item["sgid"].as_s, item["purpose"].as_s, time(item["now"]))
  text = item["expected"].as_s?
  expected = text ? GlobalId.parse(text) : nil
  failures.check("locate #{label(item)}", (located ? located.to_s : nil).inspect, (expected ? expected.to_s : nil).inspect)
end

attacker = Secrets.new("attacker")
["User", "Rooms::Open", "Account", "Message", "Rooms::Direct", "Session"].each do |model|
  forged = sgid_verifier(attacker).generate(Any.new(GlobalId.new(model, 1).to_s), "attachable", nil)
  failures.check("forged #{model} sgid is rejected", locate_signed(SECRETS, forged, "attachable", now).nil?)
end

v("turbo_stream_names.generate").as_a.each do |item|
  parts = item["parts"].as_a.map(&.as_s)
  failures.check("stream name", parts.join(":"), item["stream_name"].as_s)
  failures.check("signed stream #{parts.join(":")}", signed_stream_name(SECRETS, parts), item["signed"].as_s)
end

v("turbo_stream_names.verify").as_a.each do |item|
  name = verified_stream_name(SECRETS, item["signed"].as_s)
  expected = item["expected"].raw.nil? ? nil : (item["expected"].as_s? || generate(item["expected"]))
  failures.check("verified stream #{label(item)}", name.inspect, expected.inspect)
end

v("app_verifiers.generate").as_a.each do |item|
  message = app_verifier(SECRETS, item["name"].as_s).generate_raw(item["data_json"].as_s, item["purpose"].as_s?, opt_time(item["expires_at"]))
  failures.check("app verifier #{item["name"].as_s} #{item["data_json"].as_s}", message, item["message"].as_s)
end

v("app_verifiers.verify").as_a.each do |item|
  data = app_verifier(SECRETS, item["name"].as_s).verify_raw(item["message"].as_s, item["purpose"].as_s?, time(item["now"]))
  ours = data.is_a?(Failure) ? nil : data
  failures.check("app verify #{label(item)}", ours.inspect, item["expected_json"].as_s?.inspect)
end

failures.check("bcrypt cost", v("passwords.cost").as_i == BCRYPT_COST)
v("passwords.digests").as_a.each do |item|
  failures.check("digest #{item["digest"].as_s} is $2a$12$", item["digest"].as_s.starts_with?("$2a$12$"))
end
v("passwords.checks").as_a.each do |item|
  ok = password_matches?(item["password"].as_s, item["digest"].as_s)
  failures.check("password #{item["password"].as_s.inspect} against #{item["digest"].as_s}", ok == item["expected"].as_bool)
end
failures.check("seeded user", password_matches?("secret123456", v("passwords.seeded_user_digest").as_s))
ours = password_digest("pässwörd ☃", BCRYPT_MIN_COST)
failures.check("our digest", !ours.nil? && ours.starts_with?("$2a$04$") && password_matches?("pässwörd ☃", ours))
failures.check("cost below the minimum", password_digest("secret", BCRYPT_MIN_COST - 1).nil?)
failures.check("malformed digest", !password_matches?("anything", "not a digest"))

storage = JSON.parse(File.read("#{__DIR__}/../../vectors/storage.json"))
storage["filenames"].as_a.each do |item|
  sanitized = item["sanitized"].as_s
  failures.check("inline #{sanitized}", content_disposition("inline", sanitized), item["inline"].as_s)
  failures.check("attachment #{sanitized}", content_disposition("attachment", sanitized), item["attachment"].as_s)
end
failures.check("transliterated", content_disposition("inline", "Łódź ×.pdf"), "inline; filename=\"Lodz x.pdf\"; filename*=UTF-8''%C5%81%C3%B3d%C5%BA%20%C3%97.pdf")

unless failures.lines.empty?
  puts "#{failures.lines.size} mismatches:"
  failures.lines.first(40).each { |line| puts line }
  exit 1
end
