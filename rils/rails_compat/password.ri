# `has_secure_password` with `ActiveModel::SecurePassword::BCryptPassword`:
# bcrypt-ruby's `$2a$` digests at `BCrypt::Engine.cost` (12). Like
# bcrypt-ruby, only the first 72 bytes of a password count.
module rils/rails_compat/password

import rils/rails_compat/crypto::{bcrypt, bcrypt_setting, constant_time_eq?}

# `BCrypt::Engine.cost` in production.
pub BCRYPT_COST = 12
# `BCrypt::Engine::MIN_COST`, what Rails uses when
# `ActiveModel::SecurePassword.min_cost` is set (tests).
pub BCRYPT_MIN_COST = 4

# `BCrypt::Password.create(password, cost:)`: nil for a cost outside
# `MIN_COST..31`.
pub def password_digest(password : String, cost : Int32 = BCRYPT_COST) : String?
  return nil if cost < BCRYPT_MIN_COST || cost > 31
  setting = bcrypt_setting(cost)
  setting ? bcrypt(truncated(password), setting) : nil
end

# `BCrypt::Password.new(digest).is_password?(password)`; false for a
# malformed digest.
pub def password_matches?(password : String, digest : String) : Bool
  return false unless digest.starts_with?("$2")
  hashed = bcrypt(truncated(password), digest)
  hashed ? constant_time_eq?(hashed, digest) : false
end

# bcrypt reads at most 72 bytes; libcrypt refuses a longer phrase where
# bcrypt-ruby ignores the rest.
def truncated(password : String) : String
  password.bytesize > 72 ? password[0, 72] : password
end
