# `direct :fresh_user_avatar`: cache-busting avatar URL keyed by the signed
# avatar token.
pub def fresh_user_avatar_path(avatar_token : String, updated_at_number : String) : String
  "/users/#{avatar_token}/avatar?v=#{updated_at_number}"
end

# `direct :fresh_account_logo`: `v` is the account's
# `updated_at.to_fs(:number)`, when present.
pub def fresh_account_logo_path(v : String?, size : String?) : String
  query = [] of String
  query << "size=#{size}" if size
  query << "v=#{v}" if v
  query.empty? ? account_logo_path : "#{account_logo_path}?#{query.join("&")}"
end
