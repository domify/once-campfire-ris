# The Rust port's negotiation tests, each checked against
# `Mime::Type.parse` and `request.formats` in the reference.
module rils/kit/format_test

import rils/kit/format::*
import web/web/spec::*

def symbols(formats : Array(Format) | InvalidMimeType) : Array(String)
  raise formats.message if formats.is_a?(InvalidMimeType)
  formats.map(&.symbol)
end

def fmts(accept : String?, path : String, xhr : Bool) : Array(String)
  symbols(formats(NegotiationInput.new(nil, accept, nil, path, xhr)))
end

describe "formats" do
  it "fall back to HTML for a browser's Accept" do
    chrome = "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,*/*;q=0.8"
    assert fmts(chrome, "/rooms/1", false) == ["html"]
    assert fmts(nil, "/rooms/1", false) == ["html"]
    assert fmts("*/*", "/rooms/1", false) == ["*/*"]
  end

  it "read a Turbo form submission" do
    turbo = "text/vnd.turbo-stream.html, text/html, application/xhtml+xml"
    assert fmts(turbo, "/rooms/1/messages", false) == ["turbo_stream", "html"]
  end

  it "order by quality" do
    assert fmts("text/html;q=0.5, application/json", "/", false) == ["json", "html"]
    assert fmts("application/json, */*", "/", false) == ["html"]
    assert fmts("*/*, application/json;q=0.1", "/", false) == ["html"]
    assert fmts("application/json;q=0.1,text/html;q=0.1", "/", false) == ["json", "html"]
  end

  it "read q-values like Rails" do
    [
      {"text/html;q=, application/json", ["html", "json"]},
      {"text/html; q=, application/json;q=0.5", ["html", "json"]},
      {"text/html;q=;q=, application/json;q=0.5", ["html", "json"]},
      {"text/html;q=0.5, application/json;q=", ["json", "html"]},
      {"text/html;q=;x=1, application/json", ["json", "html"]},
      {"text/html;q=;q=0.9, application/json;q=0.5", ["json", "html"]},
      {"text/html;q=0.4;q=0.9, application/json;q=0.5", ["json", "html"]},
      {"text/html;q=0.5.1, application/json;q=0.6", ["json", "html"]},
      {"text/html;q=0.5.1.2, application/json;q=0.49", ["html", "json"]},
      {"text/html;q=\"0.9\", application/json;q=0.5", ["html", "json"]},
      {"text/html;q=\"\"0.9, application/json;q=0.5", ["json", "html"]},
      {"text/html;q=1e-1, application/json;q=0.5", ["json", "html"]},
      {"text/html;q=1_0, application/json;q=5", ["html", "json"]},
      {"text/html;q=abc, application/json;q=0.1", ["json", "html"]},
      {"text/html;q=+0.3, application/json;q=0.2", ["html", "json"]},
      {"text/html;q= 0.3, application/json;q=0.2", ["html", "json"]},
      {"text/html;q=1e17, application/json;q=1e18", ["json", "html"]},
      {"text/html;q=1e19, application/json;q=1e20", ["json", "html"]},
      {"text/html;q=-0.001, application/json;q=0", ["html", "json"]},
      {"application/json;q=0, text/html;q=-0.001", ["json", "html"]},
      # `String#to_f` reads hexadecimal after a sign only.
      {"text/html;q=0.5, application/json;q=+0x1", ["json", "html"]},
      {"text/html;q=0.5, application/json;q=0x1", ["html", "json"]},
    ].each do |pair|
      accept, order = pair
      assert symbols(parse_accept(accept)) == order, accept
    end
    assert symbols(parse_accept("*/*;q=, application/json;q=0.5")) == ["json", "*/*"]
    # Rails raises FloatDomainError (a 500) on an infinite q-value.
    assert symbols(parse_accept("text/html;q=1e400, application/json")) == ["html", "json"]
    assert symbols(parse_accept("text/html;q=-1e400, application/json")) == ["json", "html"]
  end

  it "read single types" do
    assert fmts("application/json", "/", false) == ["json"]
    assert fmts("application/json; charset=utf-8", "/", false) == ["json"]
    assert fmts("image/svg+xml", "/", false) == ["svg"]
    assert fmts("application/x-unknown", "/", false).empty?
    assert formats(NegotiationInput.new(nil, "garbage", nil, "/", false)).is_a?(InvalidMimeType)
  end

  it "expand wildcards in registration order" do
    expanded = fmts("text/*", "/", false)
    assert expanded[0] == "html" && expanded[1] == "text" && expanded[2] == "js"
    assert expanded.includes?("turbo_stream")
  end

  it "fold XML" do
    assert fmts("text/xml, application/rss+xml", "/", false) == ["xml", "rss"]
    assert fmts("application/xml, application/rss+xml", "/", false) == ["rss", "xml"]
    assert fmts("text/xml;q=0.9, application/xml;q=0.5, text/html", "/", false) == ["html", "xml"]
  end

  it "read path extensions and format params" do
    assert fmts(nil, "/users/1/avatar.svg", false) == ["svg"]
    assert fmts(nil, "/messages.json", false) == ["json"]
    assert fmts(nil, "/x.unknownext", false) == ["html"]
    assert symbols(formats(NegotiationInput.new("json", "text/html", nil, "/", false))) == ["json"]
    assert symbols(formats(NegotiationInput.new("nope", nil, nil, "/", false))).empty?
  end

  it "default XHR to JS" do
    assert fmts(nil, "/", true) == ["js"]
    assert symbols(formats(NegotiationInput.new(nil, nil, "application/json", "/", true))) == ["json"]
  end

  it "negotiate" do
    assert negotiate([TURBO_STREAM, HTML], [HTML, JSON_MIME]) == HTML
    assert negotiate([ALL], [HTML, JSON_MIME]) == HTML
    assert negotiate([PNG], [HTML, JSON_MIME]).nil?
    assert negotiate([PNG], [HTML, ALL]) == PNG
    assert negotiate([] of Format, [HTML]).nil?
  end
end
