# One entry of `Marcel::MAGIC`: `[offset, value, children]`, where the
# offset may be a Range (`offset..range_end`).
pub class Match
  getter offset : Int32
  getter range_end : Int32?
  getter value : String?
  getter children : Array(Match)

  def initialize(@offset : Int32, @range_end : Int32?, @value : String?, @children : Array(Match))
  end
end

def m(offset : Int32, range_end : Int32?, value : String?, children : Array(Match) = [] of Match) : Match
  Match.new(offset, range_end, value, children)
end

