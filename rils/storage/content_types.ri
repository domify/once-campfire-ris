# The effective `config.active_storage` content type lists: Rails 8.2's
# engine defaults with `load_defaults 8.2`, minus the types
# `reference/config/initializers/vips.rb` removes.
module rils/storage/content_types

# `variable_content_types` (bmp, ico and psd removed by vips.rb).
pub VARIABLE = ["image/png", "image/gif", "image/jpeg", "image/tiff", "image/webp", "image/avif", "image/heic", "image/heif"]

# `web_image_content_types` (webp added by `load_defaults 7.2`).
pub WEB_IMAGE = ["image/png", "image/jpeg", "image/gif", "image/webp"]

pub ALLOWED_INLINE = [
  "image/webp", "image/avif", "image/png", "image/gif", "image/jpeg", "image/tiff", "image/bmp",
  "image/vnd.adobe.photoshop", "image/vnd.microsoft.icon", "application/pdf",
]

pub SERVE_AS_BINARY = [
  "text/html", "image/svg+xml", "application/postscript", "application/x-shockwave-flash", "text/xml",
  "application/xml", "application/xhtml+xml", "application/mathml+xml", "text/cache-manifest",
]

pub BINARY_CONTENT_TYPE = "application/octet-stream"

# `ActiveStorage.video_preview_arguments` from `load_defaults 7.0`, already
# shell-split.
pub VIDEO_PREVIEW_ARGUMENTS = [
  "-vf", "select=eq(n\\,0)+eq(key\\,1)+gt(scene\\,0.015),loop=loop=-1:size=2,trim=start_frame=1",
  "-frames:v", "1", "-f", "image2",
]

pub def variable?(content_type : String) : Bool
  VARIABLE.includes?(content_type)
end

pub def web_image?(content_type : String) : Bool
  WEB_IMAGE.includes?(content_type)
end

pub def allowed_inline?(content_type : String) : Bool
  ALLOWED_INLINE.includes?(content_type)
end

pub def serve_as_binary?(content_type : String) : Bool
  SERVE_AS_BINARY.includes?(content_type)
end

# `content_type_for_serving`.
pub def for_serving(content_type : String) : String
  serve_as_binary?(content_type) ? BINARY_CONTENT_TYPE : content_type
end

# `forced_disposition_for_serving`: "attachment" for binary or non-inline
# types.
pub def forced_disposition(content_type : String) : String?
  serve_as_binary?(content_type) || !allowed_inline?(content_type) ? "attachment" : nil
end

# `ActiveStorage.paths` is empty in Campfire, so the binaries come from PATH.
pub FFMPEG = "ffmpeg"
pub FFPROBE = "ffprobe"
