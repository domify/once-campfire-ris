# `ActiveStorage::Filename`, with Ruby's `File.extname`/`File.basename`
# semantics. Strings are bytes here, and every character these rules look at
# is ASCII, so they work on bytes.
module rils/storage/filename

import std/text
import rils/ruby/text::{strip}

pub class Filename
  # The stored (unsanitized) value, as written to
  # `active_storage_blobs.filename`.
  getter raw : String

  def initialize(@raw : String)
  end

  # Bytes as they arrived; invalid UTF-8 is replaced with U+FFFD, as
  # `sanitized`'s `encode(invalid: :replace)` does.
  pub def self.from_bytes(bytes : String) : Filename
    Filename.new(scrub(bytes))
  end

  # `File.basename(filename, extension_with_delimiter)`.
  pub def base : String
    name = basename(@raw)
    ext = extension_with_delimiter
    if !ext.empty? && name.bytesize > ext.bytesize && name.ends_with?(ext)
      name[0, name.bytesize - ext.bytesize]
    else
      name
    end
  end

  pub def extension_with_delimiter : String
    extname(@raw)
  end

  # `extension_without_delimiter`, aliased as `extension`.
  pub def extension : String
    ext = extension_with_delimiter
    ext.empty? ? "" : ext[1, ext.bytesize - 1]
  end

  # `strip`, then the RTL override, path separators and shell/HTML
  # metacharacters each become "-".
  pub def sanitized : String
    text = strip(@raw)
    bytes = text.as_tape
    String.build(text.bytesize) do |io|
      i = 0
      while i < text.bytesize
        byte = bytes[i]
        if byte == 0xE2 && i + 2 < text.bytesize && bytes[i + 1] == 0x80 && bytes[i + 2] == 0xAE
          io << '-'
          i += 3
        else
          io.write_byte(unsafe?(byte) ? '-'.ord.to_u8 : byte)
          i += 1
        end
      end
    end
  end

  pub def to_s : String
    sanitized
  end

  pub def ==(other : Filename) : Bool
    @raw == other.raw
  end
end

UNSAFE = "%$|:;/<>?*\"\t\r\n\\"

def unsafe?(byte : UInt8) : Bool
  i = 0
  while i < UNSAFE.bytesize
    return true if UNSAFE.as_tape[i] == byte
    i += 1
  end
  false
end

# `File.basename(path)`: the last component, ignoring trailing slashes.
pub def basename(path : String) : String
  stop = path.bytesize
  while stop > 0 && path.as_tape[stop - 1] == '/'.ord
    stop -= 1
  end
  return path.empty? ? "" : "/" if stop == 0
  start = stop
  while start > 0 && path.as_tape[start - 1] != '/'.ord
    start -= 1
  end
  path[start, stop - start]
end

# `File.extname(path)` on Unix: leading dots don't start an extension, and
# a trailing dot is an extension of its own (`"foo."` → `"."`).
pub def extname(path : String) : String
  name = basename(path)
  first = 0
  while first < name.bytesize && name.as_tape[first] == '.'.ord
    first += 1
  end
  dot = name.bytesize - 1
  while dot >= first && name.as_tape[dot] != '.'.ord
    dot -= 1
  end
  dot >= first ? name[dot, name.bytesize - dot] : ""
end

# Invalid UTF-8 replaced with U+FFFD, one replacement per maximal invalid
# subpart (what `String::from_utf8_lossy` and Ruby's `scrub` both do).
pub def scrub(bytes : String) : String
  data = bytes.as_tape
  size = bytes.bytesize
  String.build(size) do |io|
    i = 0
    while i < size
      lead = data[i]
      if lead < 0x80
        io.write_byte(lead)
        i += 1
        next
      end
      width = 0
      low = 0x80
      high = 0xBF
      if lead >= 0xC2 && lead <= 0xDF
        width = 2
      elsif lead >= 0xE0 && lead <= 0xEF
        width = 3
        low = 0xA0 if lead == 0xE0
        high = 0x9F if lead == 0xED
      elsif lead >= 0xF0 && lead <= 0xF4
        width = 4
        low = 0x90 if lead == 0xF0
        high = 0x8F if lead == 0xF4
      end
      j = i + 1
      if width > 0
        if j < size && data[j] >= low && data[j] <= high
          j += 1
          while j < i + width && j < size && data[j] >= 0x80 && data[j] <= 0xBF
            j += 1
          end
        end
      end
      if width > 0 && j == i + width
        io << bytes[i, width]
      else
        io << '\u{FFFD}'
      end
      i = j
    end
  end
end
